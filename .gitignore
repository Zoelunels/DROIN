# DROIN: the Expo app, promo animation and brand assets (frontend/). frontend/mobile/.gitignore adds its
# own rules on top of these.

# Kept out of this (public) repo: the backend and its server setup live in a private repo of their own,
# and .claude/ is Claude Code's local settings for this machine.
backend/
deploy/
.claude/

# Dependencies
node_modules/

# Secrets and local settings — commit .env.example, never .env
.env
.env.*
!.env.example

# Local-only notes
*.local.md

# Backup of frontend/mobile's old standalone .git (from before the monorepo); safe to delete
.backup/

# Logs (backend-dev.log, frontend-dev.log, …)
*.log
logs/

# Expo / build output
.expo/
dist/
web-build/
*.tsbuildinfo

# Rendered promo videos: large generated files (~180 MB); re-render from frontend/animation/*.html
frontend/animation/renders/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Deploy archive made for scp to the server
*.tgz
