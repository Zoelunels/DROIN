  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "hono": "^4.13.9",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
