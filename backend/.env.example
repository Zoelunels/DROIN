PORT=3000
DATABASE_URL=postgres://bukukas:bukukas@localhost:5432/bukukas

# Tests use a separate database (created automatically, wiped on every run).
TEST_DATABASE_URL=postgres://bukukas:bukukas@localhost:5432/bukukas_test

# Where receipt photos are stored, relative to the backend folder.
UPLOAD_DIR=uploads

# "off" = log push notifications instead of sending them through Expo.
PUSH_NOTIFICATIONS=on

# Voice input: speech-to-text through any OpenAI-compatible /audio/transcriptions API.
# Groq (default URL/model) or OpenAI (STT_API_URL=https://api.openai.com/v1, STT_MODEL=gpt-4o-mini-transcribe).
# Without a key, POST /quick-input/voice answers 503 and the app falls back to typing.
STT_API_KEY=
STT_API_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=id
