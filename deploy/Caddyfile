# HTTPS for the DROIN API, once you have a domain (see deploy/DEPLOY.md, step 5).
# APPEND this block to the server's /etc/caddy/Caddyfile; don't replace that file, it can hold other
# sites. Replace api.example.my.id with your own domain; Caddy gets and renews the certificate itself.
api.example.my.id {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
