# The server's backend/.env. install.sh fills in the database password the first time and never
# overwrites this file afterwards, so changes made on the server stay.
PORT=3000
DATABASE_URL=postgres://droin:__DB_PASSWORD__@127.0.0.1:5432/droin

# Receipt photos, relative to the backend folder. Backed up nightly by deploy/backup.sh.
UPLOAD_DIR=uploads

# Daily reminders through Expo's push service.
PUSH_NOTIFICATIONS=on

# PaddleOCR for receipt scans, started by the backend itself. With only ~1 GB of RAM free, set
# OCR_SERVICE_URL=off to use the lighter (but much less accurate) Tesseract instead.
OCR_SERVICE_URL=http://127.0.0.1:8866
OCR_AUTOSTART=on
