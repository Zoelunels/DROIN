# Store text with LF line endings in the repo, whatever the editor on Windows writes.
# Stops the "LF will be replaced by CRLF" warnings and noisy whole-file diffs.
* text=auto eol=lf

# Binary files: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.m4a binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles: keep as text, but don't show them in diffs by default.
bun.lock -diff linguist-generated
